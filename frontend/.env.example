# =============================================================================
# CommerceFlow AI — Frontend Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in your values.
# .env.local is NOT committed to git.
# Vite exposes only variables prefixed with VITE_ to the browser bundle.
# =============================================================================

# ── API Base URL ──────────────────────────────────────────────────────────────
# Controls where the frontend sends API requests.
#
# LOCAL DEVELOPMENT (leave empty):
#   Empty string = use the Vite dev server proxy.
#   The proxy forwards /api/* → http://127.0.0.1:8000 (no CORS issues).
VITE_API_URL=

# DOCKER COMPOSE:
#   Leave empty — nginx in the frontend container proxies /api/* → backend:8000.
# VITE_API_URL=

# PRODUCTION (direct backend URL):
#   Set to your deployed backend URL. Must NOT have a trailing slash.
# VITE_API_URL=https://api.your-domain.com

# ── Important Security Notes ──────────────────────────────────────────────────
# - NEVER put API keys, JWT secrets, or database credentials here.
# - All VITE_ variables are embedded in the browser bundle and are PUBLIC.
# - Only put values that are safe to expose in client-side JavaScript.
