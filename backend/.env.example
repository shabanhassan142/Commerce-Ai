# =============================================================================
# CommerceFlow AI — Backend Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
#
# Required variables marked with [REQUIRED] — the app will refuse to start
# if these are missing or invalid.
# =============================================================================

# ── Application ───────────────────────────────────────────────────────────────
APP_NAME="CommerceFlow AI"
APP_VERSION="1.0.0"

# ENVIRONMENT controls: CORS policy, Swagger docs availability, log format.
# development → Swagger docs enabled, CORS *, colored logs
# production  → Swagger docs disabled, CORS restricted, JSON logs
ENVIRONMENT="development"          # development | staging | production

DEBUG=true                         # Set false in production

# ── PostgreSQL Database ───────────────────────────────────────────────────────
# Format: postgresql+asyncpg://user:password@host:port/dbname
# [REQUIRED] — must use postgresql+asyncpg:// for async support.
#
# Local dev (default Docker port):
DATABASE_URL="postgresql+asyncpg://commerceflow:commerceflow_secret@localhost:5433/commerceflow_db"
#
# Docker Compose (backend container):
# DATABASE_URL="postgresql+asyncpg://commerceflow:commerceflow_secret@postgres:5432/commerceflow_db"

# ── JWT Authentication ────────────────────────────────────────────────────────
# [REQUIRED] — must be at least 32 characters long.
# Generate a strong secret: openssl rand -hex 32
SECRET_KEY="CHANGE_THIS_TO_A_STRONG_RANDOM_SECRET_KEY_MIN_32_CHARS"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── LLM Provider (OpenRouter) ─────────────────────────────────────────────────
# [OPTIONAL] — if not set, the AI chat uses rule-based fallback routing.
# Get a free key at: https://openrouter.ai
LLM_PROVIDER="openrouter"          # openrouter | openai | anthropic
LLM_MODEL="qwen/qwen3-30b-a3b:free"
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=2048
OPENROUTER_API_KEY="your_openrouter_api_key_here"
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"

# ── FAISS & Embeddings ────────────────────────────────────────────────────────
# Path to the FAISS index files (relative to backend/ working directory).
# In Docker, this directory is mounted as a read-only volume.
# NEVER set this to auto-generate on startup — the index is pre-built.
FAISS_INDEX_PATH="faiss/index"
EMBEDDING_MODEL="BAAI/bge-small-en-v1.5"
CHUNK_SIZE=512
CHUNK_OVERLAP=64

# ── File Uploads ──────────────────────────────────────────────────────────────
UPLOAD_DIR="uploads"
MAX_UPLOAD_SIZE_MB=10
ALLOWED_EXTENSIONS="pdf,txt,docx,md"

# ── CORS ──────────────────────────────────────────────────────────────────────
# Only applies when ENVIRONMENT=production (development allows all origins).
# Comma-separated list of allowed origins.
ALLOWED_ORIGINS="http://localhost:5174,http://localhost:3000"
# Production example:
# ALLOWED_ORIGINS="https://your-domain.com,https://www.your-domain.com"

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL="INFO"                   # DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_FILE="logs/commerceflow.log"
LOG_MAX_BYTES=10485760             # 10 MB
LOG_BACKUP_COUNT=5

# ── Docker / PostgreSQL Container Variables ────────────────────────────────────
# Used by docker-compose.yml for the postgres service.
# Must match the credentials in DATABASE_URL.
POSTGRES_USER=commerceflow
POSTGRES_PASSWORD=commerceflow_secret
POSTGRES_DB=commerceflow_db
